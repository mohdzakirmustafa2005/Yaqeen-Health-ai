{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated individual profile, language, consent, and reminder preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "department": { "type": "string" },
        "organizationId": { "type": "string" },
        "role": { "type": "string", "enum": ["INDIVIDUAL", "COORDINATOR", "ORG_ADMIN", "PLATFORM_ADMIN"] },
        "language": { "type": "string", "enum": ["EN", "HI", "TE", "UR"] },
        "consentAnalytics": { "type": "boolean" },
        "consentAiGuidance": { "type": "boolean" },
        "consentCoordinatorOutreach": { "type": "boolean" },
        "remindersEnabled": { "type": "boolean" },
        "reminderHour": { "type": "integer" },
        "reminderMinute": { "type": "integer" },
        "onboardingCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "displayName", "department", "organizationId", "role", "language",
        "consentAnalytics", "consentAiGuidance", "consentCoordinatorOutreach",
        "remindersEnabled", "reminderHour", "reminderMinute", "onboardingCompleted",
        "createdAt", "updatedAt"
      ]
    },
    "HealthCheckIn": {
      "title": "HealthCheckIn",
      "description": "Daily wellbeing, sleep, stress, fatigue, symptoms, hydration, and activity check-in.",
      "type": "object",
      "required": [
        "userId", "dateKey", "overallWellbeing", "sleepQuality", "sleepHours",
        "stressLevel", "energyLevel", "fatigueLevel", "mood", "symptoms",
        "workStress", "hydrationLiters", "activityMinutes", "computedRiskLevel",
        "createdAt", "updatedAt"
      ]
    },
    "RiskAlert": {
      "title": "RiskAlert",
      "description": "Explainable early health warning alert generated by the rule-based risk engine.",
      "type": "object",
      "required": [
        "userId", "riskLevel", "title", "explanation", "recommendedNextStep",
        "triggerFactors", "dateKey", "status", "createdAt", "updatedAt"
      ]
    },
    "WellnessRecommendation": {
      "title": "WellnessRecommendation",
      "description": "Personalized non-diagnostic preventive recommendation.",
      "type": "object",
      "required": ["userId", "category", "title", "description", "frequency", "completed", "source", "createdAt", "updatedAt"]
    },
    "AiChatMessage": {
      "title": "AiChatMessage",
      "description": "Conversational turn in the AI Health Assistant.",
      "type": "object",
      "required": ["userId", "sender", "text", "language", "fallbackUsed", "createdAt"]
    },
    "SmartNotification": {
      "title": "SmartNotification",
      "description": "User wellness notification and reminder.",
      "type": "object",
      "required": ["userId", "category", "title", "body", "readStatus", "createdAt", "updatedAt"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Immutable privacy and security audit trail event.",
      "type": "object",
      "required": ["userId", "action", "details", "actorRole", "createdAt"]
    },
    "DoctorAIConversation": {
      "title": "DoctorAIConversation",
      "description": "AI Doctor and Heart Specialist conversation thread metadata.",
      "type": "object",
      "required": ["userId", "domain", "mode", "title", "lastPreview", "messageCount", "createdAt", "updatedAt"]
    },
    "DoctorAIMessage": {
      "title": "DoctorAIMessage",
      "description": "Structured AI Doctor or Heart Specialist chat message.",
      "type": "object",
      "required": ["userId", "conversationId", "sender", "mode", "taskType", "text", "providerUsed", "feedback", "emergencyTriggered", "fallbackUsed", "language", "createdAt", "updatedAt"]
    },
    "HeartHealthProfile": {
      "title": "HeartHealthProfile",
      "description": "User-entered cardiovascular background, medications, allergies, and risk-awareness profile.",
      "type": "object",
      "required": ["userId", "knownConditions", "medications", "allergies", "smokingStatus", "familyHeartHistory", "baselineActivityLevel", "createdAt", "updatedAt"]
    },
    "HeartMeasurement": {
      "title": "HeartMeasurement",
      "description": "User-entered cardiovascular vitals & lab metrics (HR, BP, SpO2, weight, glucose, cholesterol).",
      "type": "object",
      "required": ["userId", "recordedAtIso", "symptoms", "activityLevel", "sourceLabel", "emergencyFlagged", "createdAt", "updatedAt"]
    },
    "BloodPressureRecord": {
      "title": "BloodPressureRecord",
      "description": "Dedicated user-entered systolic/diastolic blood pressure log entry.",
      "type": "object",
      "required": ["userId", "recordedAtIso", "systolicMmHg", "diastolicMmHg", "postureOrContext", "sourceLabel", "createdAt"]
    },
    "HeartSymptomReport": {
      "title": "HeartSymptomReport",
      "description": "Heart symptom safety screening & educational follow-up record.",
      "type": "object",
      "required": ["userId", "symptoms", "severityScore", "durationLabel", "associatedSymptoms", "emergencyTriggered", "screeningReason", "aiSummary", "urgencyLevel", "createdAt"]
    },
    "HealthReportUpload": {
      "title": "HealthReportUpload",
      "description": "User-uploaded or entered lab/ECG report explanation record.",
      "type": "object",
      "required": ["userId", "title", "reportType", "extractedOrEnteredText", "summary", "outOfRangeFindings", "questionsForDoctor", "emergencyTriggered", "providerUsed", "createdAt"]
    },
    "AIHealthInsight": {
      "title": "AIHealthInsight",
      "description": "Structured non-diagnostic AI insight generated by Doctor or Cardiology mode.",
      "type": "object",
      "required": ["userId", "domain", "taskType", "title", "summary", "observations", "recommendations", "urgency", "providerUsed", "fallbackUsed", "createdAt"]
    },
    "MedicalSafetyEvent": {
      "title": "MedicalSafetyEvent",
      "description": "Immutable log when emergency warning screening interrupts normal AI flow.",
      "type": "object",
      "required": ["userId", "sourceModule", "matchedSignals", "reason", "actionTaken", "emergencyRegionHint", "createdAt"]
    },
    "UserConsentRecord": {
      "title": "UserConsentRecord",
      "description": "Append-only user consent audit record for AI, analytics, reports, and outreach.",
      "type": "object",
      "required": ["userId", "consentAnalytics", "consentAiGuidance", "consentHeartAiContext", "consentReportAnalysis", "consentCoordinatorOutreach", "policyNote", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/UserProfile" } },
    "/users/{userId}/checkIns/{checkInId}": { "schema": { "$ref": "#/entities/HealthCheckIn" } },
    "/users/{userId}/alerts/{alertId}": { "schema": { "$ref": "#/entities/RiskAlert" } },
    "/users/{userId}/recommendations/{recId}": { "schema": { "$ref": "#/entities/WellnessRecommendation" } },
    "/users/{userId}/aiMessages/{msgId}": { "schema": { "$ref": "#/entities/AiChatMessage" } },
    "/users/{userId}/notifications/{notifId}": { "schema": { "$ref": "#/entities/SmartNotification" } },
    "/users/{userId}/auditLogs/{logId}": { "schema": { "$ref": "#/entities/AuditLogEntry" } },
    "/users/{userId}/doctorConversations/{convId}": { "schema": { "$ref": "#/entities/DoctorAIConversation" } },
    "/users/{userId}/doctorMessages/{msgId}": { "schema": { "$ref": "#/entities/DoctorAIMessage" } },
    "/users/{userId}/heartProfiles/{profileId}": { "schema": { "$ref": "#/entities/HeartHealthProfile" } },
    "/users/{userId}/heartMeasurements/{measId}": { "schema": { "$ref": "#/entities/HeartMeasurement" } },
    "/users/{userId}/bloodPressureRecords/{bpId}": { "schema": { "$ref": "#/entities/BloodPressureRecord" } },
    "/users/{userId}/heartSymptomReports/{repId}": { "schema": { "$ref": "#/entities/HeartSymptomReport" } },
    "/users/{userId}/healthReportUploads/{uploadId}": { "schema": { "$ref": "#/entities/HealthReportUpload" } },
    "/users/{userId}/aiInsights/{insightId}": { "schema": { "$ref": "#/entities/AIHealthInsight" } },
    "/users/{userId}/medicalSafetyEvents/{eventId}": { "schema": { "$ref": "#/entities/MedicalSafetyEvent" } },
    "/users/{userId}/consentRecords/{recordId}": { "schema": { "$ref": "#/entities/UserConsentRecord" } }
  }
}
